# Environment Variables
# Copy this file to .env and fill in your values

# DummyAPI App ID - Get it from https://dummyapi.io/
VITE_DUMMY_API_APP_ID=your_dummy_api_app_id_here

# Google OAuth Client ID - Get it from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# MongoDB Atlas Connection String (for backend use)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
